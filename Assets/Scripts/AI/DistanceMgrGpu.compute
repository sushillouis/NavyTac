#pragma kernel ComputePotentials

struct EntityData {
    float3 position;
    float3 velocity;
    float heading;
    int pfCount;
    int pfStartIndex;
};

struct CPAInfoData {
    float3 ownShipPosition;
    float3 targetPosition;
    float time;
    float range;
    float targetRelativeBearing;
    float targetAbsBearing;
    float targetAngle;
    float3 relativeVelocity;
};

struct PotentialData {
    float3 diff;
    float distance;
    float3 direction;
    float3 relativeVelocity;
    CPAInfoData cpaInfo;
    float targetAngle;
};

RWStructuredBuffer<EntityData> entityData;
RWStructuredBuffer<PotentialData> potentialData;
RWStructuredBuffer<float3> pfPositions;

int entityCount;
int maxPFPerEntity;

// Helper functions
float Degrees360(float angle) {
    angle = fmod(angle, 360.0);
    return angle < 0 ? angle + 360.0 : angle;
}

float VectorToHeading(float3 dir) {
    return Degrees360(atan2(-dir.x, dir.z) * 57.2957795);
}

[numthreads(64,1,1)]
void ComputePotentials (uint3 id : SV_DispatchThreadID) {
    uint idx = id.x;
    if(idx >= entityCount * entityCount) return;
    
    int i = idx / entityCount;
    int j = idx % entityCount;
    if(i == j) return;

    EntityData own = entityData[i];
    EntityData tgt = entityData[j];

    // Main potential calculation
    float3 diff = tgt.position - own.position;
    float distance = length(diff);
    float3 dir = normalize(diff);

    // CPA calculation
    float3 velDiff = own.velocity - tgt.velocity;
    float3 posDiff = own.position - tgt.position;
    float relSpeedSq = dot(velDiff, velDiff);
    
    CPAInfoData cpa;
    cpa.time = relSpeedSq < 1e-5 ? 0 : max(0, -dot(posDiff, velDiff) / relSpeedSq);
    cpa.ownShipPosition = own.position + own.velocity * cpa.time;
    cpa.targetPosition = tgt.position + tgt.velocity * cpa.time;
    cpa.range = distance(cpa.ownShipPosition, cpa.targetPosition);
    
    float3 cpaDiff = cpa.targetPosition - cpa.ownShipPosition;
    cpa.targetAbsBearing = VectorToHeading(cpaDiff);
    cpa.targetRelativeBearing = Degrees360(cpa.targetAbsBearing - own.heading);
    cpa.targetAngle = Degrees360(cpa.targetAbsBearing + 180 - tgt.heading);
    cpa.relativeVelocity = tgt.velocity - own.velocity;

    // Store results
    PotentialData pd;
    pd.diff = diff;
    pd.distance = distance;
    pd.direction = dir;
    pd.cpaInfo = cpa;
    pd.relativeVelocity = cpa.relativeVelocity;
    pd.targetAngle = cpa.targetAngle;

    potentialData[idx] = pd;
}
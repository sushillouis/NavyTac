#pragma kernel ClearGrid
#pragma kernel RevealAreas
#pragma kernel ApplyToTexture

// Grid parameters
int GridWidth;
int GridHeight;
float GridCellSize;
float2 GridOrigin;
float4 FogColor;
float4 PreviouslyRevealedColor; // RGBA(0.5, 0.5, 0.5, 0.5)

// Buffers & Textures
RWStructuredBuffer<float> Grid;        // Current visibility (0-1)
RWStructuredBuffer<float> VisitedGrid; // Persistent visibility (0-1)
StructuredBuffer<float4> Entities;     // XYZ = position, W = radius
RWTexture2D<float4> FogTexture;        // Output texture

///////////////////////////////////////////////////////////
// Kernel 1: ClearGrid - Reset current visibility
///////////////////////////////////////////////////////////
[numthreads(8, 8, 1)]
void ClearGrid(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= GridWidth || id.y >= GridHeight) return;
    Grid[id.x + id.y * GridWidth] = 0.0f;
}

///////////////////////////////////////////////////////////
// Kernel 2: RevealAreas - Calculate visibility
///////////////////////////////////////////////////////////
[numthreads(8, 8, 1)]
void RevealAreas(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= GridWidth || id.y >= GridHeight) return;

    float2 cellCenter = GridOrigin + float2(
        (id.x + 0.5) * GridCellSize,
        (id.y + 0.5) * GridCellSize
    );

    float maxVisibility = 0.0f;

    for (uint i = 0; i < Entities.Length; i++)
    {
        float4 entity = Entities[i];
        float2 entityPos = entity.xz;
        float radius = entity.w;

        float dist = distance(cellCenter, entityPos);
        float visibility = 1.0f - smoothstep(radius * 0.8f, radius, dist);
        maxVisibility = max(maxVisibility, visibility);
    }

    if (maxVisibility > 0)
    {
        Grid[id.x + id.y * GridWidth] = maxVisibility;
        VisitedGrid[id.x + id.y * GridWidth] = max(maxVisibility, VisitedGrid[id.x + id.y * GridWidth]);
    }
}

///////////////////////////////////////////////////////////
// Kernel 3: ApplyToTexture - Smooth blending
///////////////////////////////////////////////////////////
[numthreads(8, 8, 1)]
void ApplyToTexture(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= GridWidth || id.y >= GridHeight) return;

    float currentVisibility = Grid[id.x + id.y * GridWidth];
    float visitedVisibility = VisitedGrid[id.x + id.y * GridWidth];

    // Check if the cell is out of bounds
    if (id.x < 0 || id.x >= GridWidth || id.y < 0 || id.y >= GridHeight) {
        FogTexture[id.xy] = FogColor; // Fully fogged out
        return;
    }

    // 1. Blend between fog and grey based on visited history
    float4 visitedColor = lerp(FogColor, PreviouslyRevealedColor, visitedVisibility);

    // 2. Blend between visited color and fully transparent
    float4 finalColor = lerp(visitedColor, float4(0, 0, 0, 0), currentVisibility);

    FogTexture[id.xy] = finalColor;
}